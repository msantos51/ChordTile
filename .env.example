# Copia para .env.local e preenche para ativar as contas e a sincronização de "My songs".
# Sem estas variáveis o site funciona como antes (tudo só no browser).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Stripe Payment Links (Premium) e portal do cliente. Sem eles, os planos aparecem como "Coming soon".
VITE_STRIPE_LINK_MONTHLY=
VITE_STRIPE_LINK_YEARLY=
VITE_STRIPE_LINK_LIFETIME=
VITE_STRIPE_PORTAL_URL=
